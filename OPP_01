#include <iostream>
#include <string>

using namespace std;

class phuong_tien {
private:
    int ma_xe;
    string loai_xe;
    int gio_vao;
    int tg_do;

public:
    // Ham tao rong
    phuong_tien() {
        ma_xe = 0;
        loai_xe = "";
        gio_vao = 0;
        tg_do = 0;
    }

    // Ham tao co du lieu
    phuong_tien(int ma, string loai, int gio, int tg) {
        ma_xe = ma;
        loai_xe = loai;
        gio_vao = gio;
        tg_do = tg;
    }

    int lay_ma_xe() const {
        return ma_xe;
    }

    string lay_loai_xe() const {
        return loai_xe;
    }

    double tinh_phi() const {
        if (loai_xe == "O to") return tg_do * 20000;
        if (loai_xe == "Xe may") return tg_do * 5000;
        return tg_do * 2000;
    }

    void hien_thi() const {
        cout << "Ma xe: " << ma_xe 
             << " | Loai: " << loai_xe 
             << " | Gio vao: " << gio_vao << "h"
             << " | Thoi gian do: " << tg_do << "h"
             << " | Phi: " << tinh_phi() << " VND" << endl;
    }
};

class bai_xe {
private:
    int ma_bai;
    char kich_thuoc;
    phuong_tien pt1, pt2, pt3;
    bool co1, co2, co3;          

public:
    bai_xe() {
        ma_bai = 0;
        kich_thuoc = 'S';
        co1 = false;
        co2 = false;
        co3 = false;
    }

    bai_xe(int ma, char kt) {
        ma_bai = ma;
        kich_thuoc = kt;
        co1 = false;
        co2 = false;
        co3 = false;
    }

    int lay_ma() const {
        return ma_bai;
    }

    bool them(phuong_tien x) {
        if (!co1) {
            pt1 = x;
            co1 = true;
            cout << "-> Da them xe ma " << x.lay_ma_xe() << " vao vi tri 1.\n";
            return true;
        }
        if (!co2) {
            pt2 = x;
            co2 = true;
            cout << "-> Da them xe ma " << x.lay_ma_xe() << " vao vi tri 2.\n";
            return true;
        }
        if (!co3) {
            pt3 = x;
            co3 = true;
            cout << "-> Da them xe ma " << x.lay_ma_xe() << " vao vi tri 3.\n";
            return true;
        }
        cout << "-> Bai xe da day! Khong the them xe ma " << x.lay_ma_xe() << ".\n";
        return false;
    }

    bool xoa(int ma) {
        if (co1 && pt1.lay_ma_xe() == ma) {
            co1 = false;
            cout << "-> Da xoa xe ma " << ma << " khoi vi tri 1.\n";
            return true;
        }
        if (co2 && pt2.lay_ma_xe() == ma) {
            co2 = false;
            cout << "-> Da xoa xe ma " << ma << " khoi vi tri 2.\n";
            return true;
        }
        if (co3 && pt3.lay_ma_xe() == ma) {
            co3 = false;
            cout << "-> Da xoa xe ma " << ma << " khoi vi tri 3.\n";
            return true;
        }
        cout << "-> Khong tim thay xe ma " << ma << " de xoa.\n";
        return false;
    }

    void tim_kiem(int ma) const {
        if (co1 && pt1.lay_ma_xe() == ma) {
            cout << "-> Tim thay tai vi tri 1: ";
            pt1.hien_thi();
            return;
        }
        if (co2 && pt2.lay_ma_xe() == ma) {
            cout << "-> Tim thay tai vi tri 2: ";
            pt2.hien_thi();
            return;
        }
        if (co3 && pt3.lay_ma_xe() == ma) {
            cout << "-> Tim thay tai vi tri 3: ";
            pt3.hien_thi();
            return;
        }
        cout << "-> Khong tim thay xe ma " << ma << " trong bai.\n";
    }

    void hien_thi() const {
        cout << "\n=== THONG TIN BAI XE (Ma: " << ma_bai << ", Kich thuoc: " << kich_thuoc << ") ===\n";
        
        cout << "Vi tri 1: ";
        if (co1) pt1.hien_thi();
        else cout << "[Trong]\n";

        cout << "Vi tri 2: ";
        if (co2) pt2.hien_thi();
        else cout << "[Trong]\n";

        cout << "Vi tri 3: ";
        if (co3) pt3.hien_thi();
        else cout << "[Trong]\n";

    }
};

class giao_dien {
public:
    void chay() {
        bai_xe bx(101, 'L');

        phuong_tien xe1(1, "O to", 8, 3);
        phuong_tien xe2(2, "Xe may", 9, 2);
        phuong_tien xe3(3, "Xe dap", 10, 4);
        phuong_tien xe4(4, "O to", 11, 1);

        // Them xe
        bx.them(xe1);
        bx.them(xe2);
        bx.them(xe3);
        bx.them(xe4); 

        bx.hien_thi();

        cout << "\n--- TIM KIEM XE ---\n";
        bx.tim_kiem(2);

        cout << "\n--- XOA XE ---\n";
        bx.xoa(1);
        bx.hien_thi();
    }
};

int main() {
    giao_dien gd;
    gd.chay();
    return 0;
}
