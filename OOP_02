    bool trung_ma_xe(int vID) const;
    int sinh_ma_ngau_nhien() const;
    void runMenu();
};

SystemInterface::SystemInterface() : so_bai_hien_tai(0) {}

bool SystemInterface::trung_ma_bai(int pID) const {
    for (int i = 0; i < so_bai_hien_tai; ++i) {
        if (ds_bai[i].lay_ma() == pID) return true;
    }
    return false;
}

bool SystemInterface::trung_ma_xe(int vID) const {
    for (int i = 0; i < so_bai_hien_tai; ++i) {
        if (ds_bai[i].tim_vi_tri_xe(vID) != -1) return true;
    }
    return false;
}

int SystemInterface::sinh_ma_ngau_nhien() const {
    return 1000 + rand() % 9000; // Sinh ma ngau nhien tu 1000 - 9999
}

